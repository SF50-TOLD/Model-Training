{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SF50-TOLD/Model-Training/blob/main/schema/notam_extraction.schema.json",
  "schemaVersion": "2.0.0",
  "title": "NOTAMExtraction",
  "description": "Runway-performance facts stated in one NOTAM: for each runway direction, whether it is closed for takeoff or landing, any closed portion, its threshold displacement, its stated TORA and LDA and its surface condition; and any aerodrome obstacles. Records only what the text states; absent facts are null. See SCHEMA.md for the rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["isCanceled", "effects", "obstacles"],
  "properties": {
    "isCanceled": {
      "type": "boolean",
      "description": "True only when the NOTAM text itself says it is a cancellation (NOTAMC, CANCELED, CNL). When true, effects and obstacles are empty."
    },
    "effects": {
      "type": "array",
      "description": "One entry per runway direction the NOTAM states a fact about; a pair written as 09/27 gives one entry per direction. Empty when nothing affects runway performance.",
      "items": { "$ref": "#/$defs/RunwayEffect" }
    },
    "obstacles": {
      "type": "array",
      "description": "Obstacles in the aerodrome environment with a stated height or distance. Empty when none.",
      "items": { "$ref": "#/$defs/Obstacle" }
    }
  },
  "$defs": {
    "RunwayEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runway",
        "closure",
        "partialClosure",
        "thresholdDisplacement",
        "declaredDistances",
        "surfaceCondition"
      ],
      "properties": {
        "runway": {
          "type": ["string", "null"],
          "pattern": "^\\d{2}[LCR]?$",
          "description": "One runway direction, zero-padded (\"09R\"). Null when the effect applies to the aerodrome or to all runways."
        },
        "closure": {
          "type": "string",
          "enum": ["none", "takeoff", "landing", "both"],
          "description": "Which operations the text states this direction is closed to."
        },
        "partialClosure": {
          "anyOf": [{ "$ref": "#/$defs/PartialClosure" }, { "type": "null" }],
          "description": "A stated closed portion of this direction, with its length and end when stated."
        },
        "thresholdDisplacement": {
          "anyOf": [{ "$ref": "#/$defs/Length" }, { "type": "null" }],
          "description": "The stated total displacement of this direction's threshold."
        },
        "declaredDistances": {
          "anyOf": [{ "$ref": "#/$defs/DeclaredDistances" }, { "type": "null" }],
          "description": "TORA and LDA as stated for this direction."
        },
        "surfaceCondition": {
          "anyOf": [{ "$ref": "#/$defs/SurfaceCondition" }, { "type": "null" }],
          "description": "A runway condition report (FICON, RSC, SNOWTAM)."
        }
      }
    },
    "PartialClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "end"],
      "properties": {
        "length": {
          "anyOf": [{ "$ref": "#/$defs/Length" }, { "type": "null" }],
          "description": "Length of the closed portion, when stated."
        },
        "end": {
          "anyOf": [
            { "$ref": "#/$defs/RelativeEnd" },
            { "$ref": "#/$defs/CompassPoint" },
            { "$ref": "#/$defs/RunwayEndDesignator" },
            { "type": "null" }
          ],
          "description": "Where the closed portion is, as stated: thresholdEnd (FIRST n), departureEnd (LAST n), a compass point, or a runway end (\"27L\")."
        }
      }
    },
    "RelativeEnd": { "type": "string", "enum": ["thresholdEnd", "departureEnd"] },
    "RunwayEndDesignator": { "type": "string", "pattern": "^\\d{2}[LCR]?$" },
    "CompassPoint": {
      "type": "string",
      "enum": ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
    },
    "Length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["ft", "m"] }
      }
    },
    "Distance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["ft", "m", "nm"] }
      }
    },
    "Depth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["in", "mm"] }
      }
    },
    "Height": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "datum"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["ft", "m"] },
        "datum": {
          "type": "string",
          "enum": ["AGL", "MSL"],
          "description": "Above ground (AGL, HGT) or above sea level (MSL, AMSL, ELEV), as stated."
        }
      }
    },
    "DeclaredDistances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TORA", "LDA"],
      "properties": {
        "TORA": { "anyOf": [{ "$ref": "#/$defs/Length" }, { "type": "null" }] },
        "LDA": { "anyOf": [{ "$ref": "#/$defs/Length" }, { "type": "null" }] }
      }
    },
    "SurfaceCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rwyCC", "contaminants"],
      "properties": {
        "rwyCC": {
          "type": ["array", "null"],
          "description": "Runway condition codes as reported, in reporting order (\"5/5/3\" → [5, 5, 3]).",
          "items": { "type": "integer", "minimum": 0, "maximum": 6 }
        },
        "contaminants": {
          "type": "array",
          "items": { "$ref": "#/$defs/Contaminant" }
        }
      }
    },
    "Contaminant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coveragePercent", "depth"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "wet",
            "water",
            "slush",
            "wetSnow",
            "drySnow",
            "compactedSnow",
            "frost",
            "ice",
            "wetIce",
            "slushOverIce",
            "waterOverCompactedSnow",
            "drySnowOverCompactedSnow",
            "wetSnowOverCompactedSnow",
            "drySnowOverIce",
            "wetSnowOverIce",
            "other"
          ]
        },
        "coveragePercent": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "depth": {
          "anyOf": [{ "$ref": "#/$defs/Depth" }, { "type": "null" }]
        }
      }
    },
    "Obstacle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "distance", "reference", "direction"],
      "properties": {
        "height": {
          "anyOf": [{ "$ref": "#/$defs/Height" }, { "type": "null" }],
          "description": "The stated height, with its datum."
        },
        "distance": {
          "anyOf": [{ "$ref": "#/$defs/Distance" }, { "type": "null" }],
          "description": "The stated distance from the reference."
        },
        "reference": {
          "anyOf": [{ "$ref": "#/$defs/ObstacleReference" }, { "type": "null" }],
          "description": "What the distance is measured from. Null exactly when distance is null."
        },
        "direction": {
          "anyOf": [
            { "$ref": "#/$defs/CompassPoint" },
            { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
            { "type": "null" }
          ],
          "description": "Direction from the reference as stated: a 16-point compass word (\"WNW\") or degrees (\"270 DEG\", \"RDL 114\")."
        }
      }
    },
    "ObstacleReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runway"],
      "properties": {
        "kind": { "type": "string", "enum": ["departureEnd", "threshold", "ARP", "other"] },
        "runway": {
          "type": ["string", "null"],
          "pattern": "^\\d{2}[LCR]?$",
          "description": "The runway end's direction for departureEnd and threshold; null for ARP and other."
        }
      }
    }
  }
}
